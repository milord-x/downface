        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%lld 对比上周 %lld"
          }
        }
      }
    },
    "%lld push-ups tracked with Downface — the offline push-up counter that watches your face, not a sensor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Liegestütze mit Downface erfasst — der Offline-Liegestütz-Zähler, der dein Gesicht beobachtet, nicht einen Sensor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld push-ups tracked with Downface — the offline push-up counter that watches your face, not a sensor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld flexiones registradas con Downface — el contador de flexiones sin conexión que observa tu cara, no un sensor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pompes suivies avec Downface — le compteur de pompes hors ligne qui observe ton visage, pas un capteur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Downfaceで%lld回の腕立て伏せを記録 — センサーではなく顔を見るオフライン腕立てカウンター。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Downface арқылы %lld жаттығу тіркелді — сенсорды емес, бетіңді бақылайтын оффлайн жаттығу есептегіші."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld flexões registradas com Downface — o contador de flexões offline que observa seu rosto, não um sensor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld отжиманий отслежено в Downface — офлайн-счётчик отжиманий, который следит за лицом, а не за датчиком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用Downface记录了%lld次俯卧撑 — 离线俯卧撑计数器，靠识别面部而非传感器。"
          }
        }
      }
    },
