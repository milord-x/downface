    "Keeps an encrypted copy of your workout history in your iCloud account, so moving to a new phone restores it automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahrt eine verschlüsselte Kopie deines Trainingsverlaufs in deinem iCloud-Konto auf, damit sie beim Wechsel auf ein neues iPhone automatisch wiederhergestellt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps an encrypted copy of your workout history in your iCloud account, so moving to a new phone restores it automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una copia cifrada de tu historial de entrenamientos en tu cuenta de iCloud, para que al cambiar de teléfono se restaure automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve une copie chiffrée de ton historique d'entraînement dans ton compte iCloud, pour qu'elle soit restaurée automatiquement sur un nouvel iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレーニング履歴の暗号化されたコピーをiCloudアカウントに保存し、新しいiPhoneに機種変更した際に自動で復元します。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаттығу тарихыңыздың шифрланған көшірмесін iCloud есептік жазбаңызда сақтайды, сондықтан жаңа телефонға көшкенде ол автоматты түрде қалпына келтіріледі."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém uma cópia criptografada do seu histórico de treinos na sua conta do iCloud, para que ao trocar de aparelho ela seja restaurada automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранит зашифрованную копию истории тренировок в вашем iCloud, поэтому при смене телефона она восстановится автоматически."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的iCloud账户中保留一份加密的训练记录副本，这样换新手机时会自动恢复。"
          }
        }
      }
    },
