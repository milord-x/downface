    "Writes each finished set to Health as a workout, so it shows up alongside your other activity.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder abgeschlossene Satz wird als Training in Health gespeichert, zusammen mit deiner übrigen Aktivität."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writes each finished set to Health as a workout, so it shows up alongside your other activity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada serie terminada se guarda en Salud como un entrenamiento, junto con tu otra actividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque série terminée est enregistrée dans Santé comme un entraînement, avec vos autres activités."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了したセットはワークアウトとしてヘルスケアに記録され、他のアクティビティと一緒に表示されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "аяқталған әр сет Денсаулыққа жаттығу ретінде жазылады, басқа белсенділікпен қатар көрінеді."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada série concluída é registrada no Saúde como um treino, junto com suas outras atividades."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый завершённый подход записывается в Health как тренировка, наравне с остальной активностью."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每完成一组都会作为一次锻炼写入健康应用，与你的其他活动一起显示。"
          }
        }
      }
    },
