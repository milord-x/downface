            "value": "%@%lld vs %lld semana anterior"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%lld vs %lld semaine précédente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%lld 前週は%lld"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%lld алдыңғы аптада %lld болды"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%lld vs %lld semana anterior"
