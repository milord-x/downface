    "This removes every workout on this device. This cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Trainings auf diesem Gerät entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes every workout on this device. This cannot be undone."
          }
        },
