    "Downface can send you one gentle reminder a day if you haven't done a set yet. No spam, easy to turn off anytime.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downface kann dir einmal täglich eine sanfte Erinnerung schicken, falls du noch keinen Satz gemacht hast. Kein Spam, jederzeit abschaltbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downface can send you one gentle reminder a day if you haven't done a set yet. No spam, easy to turn off anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Downface puede enviarte un recordatorio suave al día si aún no has hecho una serie. Sin spam, fácil de desactivar cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Downface peut vous envoyer un rappel discret une fois par jour si vous n'avez pas encore fait de série. Pas de spam, désactivable à tout moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その日にまだセットをしていない場合、Downfaceが1日1回やさしくお知らせします。スパムはなく、いつでもオフにできます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "егер бүгін әлі жаттығу жасамасаң, Downface күніне бір рет жайлап еске салады. Спам жоқ, кез келген уақытта өшіруге болады."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Downface pode te enviar um lembrete suave por dia se você ainda não fez uma série. Sem spam, fácil de desativar quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Downface может напомнить один раз в день, если вы ещё не сделали подход. Без спама, можно отключить в любой момент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你今天还没做训练，Downface 每天可以温和地提醒你一次。绝不打扰，随时可关闭。"
          }
        }
      }
    },
